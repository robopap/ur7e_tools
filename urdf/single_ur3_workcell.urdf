<?xml version="1.0"?>

<robot name="single_ur3_workcell">

  <link name="world"/>

  <link name="vention_workcell">
    <visual>
      <origin
        xyz="0 0 0"
        rpy="1.5708 0 0"/>
      <geometry>
        <mesh
          filename="package://ur7e_tools/meshes/vention_workcell.stl"
          scale="0.0001 0.0001 0.0001"/>
      </geometry>
      <material name="vention_blue">
        <color rgba="0.15 0.35 0.80 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="world_to_vention_workcell" type="fixed">
    <parent link="world"/>
    <child link="vention_workcell"/>
    <origin
      xyz="0 0 0"
      rpy="0 0 0"/>
  </joint>

</robot>