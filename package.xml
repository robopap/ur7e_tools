<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
           schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>ur7e_tools</name>
  <version>0.0.0</version>

  <description>
    ROS 2 tools and UI for single and dual Universal Robots workcells with
    NANSENSE, force/torque sensing, visualization, and experiment control.
  </description>

  <maintainer email="mines@todo.todo">mines</maintainer>
  <license>TODO: License declaration</license>

  <!-- Core ROS -->
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>control_msgs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>rcl_interfaces</depend>

  <!-- Launch / package discovery -->
  <depend>ament_index_python</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <!-- Launch-time robot stack -->
  <exec_depend>ur_robot_driver</exec_depend>
  <exec_depend>ur_client_library</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- Universal Robots / visualization -->
  <exec_depend>ur_dashboard_msgs</exec_depend>
  <exec_depend>realsense2_description</exec_depend>

  <!-- Runtime Python / robotics -->
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>coal</exec_depend>
  <exec_depend>pinocchio</exec_depend>

  <!-- Tests -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
